/.gradle
# Every module's build dir, not just the root's. A root-anchored /build/ silently
# stopped covering anything once the tree gained :core and :desktop.
**/build/
/.idea/
/.kotlin/

.DS_Store
*.iml
*.log
*.tmp
*.bak
# oku report build output and kit symlink
docs/reports/dist/
docs/reports/_oku
docs/reports/index.html

# Eclipse/JDT artifacts (created by language servers, not by the build)
.classpath
.project
.settings/
bin/
