<configuration>
    <!-- Standard output is the command's answer and nothing else; what the engine logs goes to
         standard error, and only what a reader of a terminal should see. Named apart from the
         desktop's logback.xml because both jars share the installed app's classpath; `main` and
         the bundled launcher scripts select it by `-Dlogback.configurationFile`. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>%-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.apache.avro" level="WARN" />
    <logger name="org.eclipse.elk" level="WARN" />
    <logger name="org.duckdb" level="WARN" />

    <root level="WARN">
        <appender-ref ref="STDERR" />
    </root>
</configuration>
